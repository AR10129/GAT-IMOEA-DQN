@echo off
rem B1: IMOEA/D-AWN (Jin et al. 2023) and IMEA-IED (Cui et al. 2024) on Suite A and Suite B; run after B3.
rem Suite A goes to experiment suite_a_main = one table with every method: it reuses the suite_a
rem runs and agents; the frozen method is re-run (it must reproduce the A1 ablation runs exactly).
rem Re-running resumes: finished runs are skipped. Launch detached:
rem   powershell -Command "Start-Process cmd -ArgumentList '/c scripts\run_b1.cmd' -WindowStyle Hidden"
cd /d %~dp0..
.venv\Scripts\python.exe -u scripts\experiment.py --name suite_a_main --reuse-from suite_a --policies final imoead ip_moea fixed_fav trained_stable fresh heuristics nsga2_mid nsga2_int nsga3_mid imoead_awn imea_ied --train-seeds 0 1 2 --reference final --rank-metric IGD --scenario default --energy-scope device --external-io device --makespan sum_apps --generations 1000 --seeds 10 --test-set small_20_i0@x1 small_20_i0@x20 small_50_i0@x1 small_50_i0@x20 basic_60_i0@x1 basic_60_i0@x20 basic_100_i0@x1 basic_100_i0@x20 medium_100_i0@x1 medium_100_i0@x20 medium_250_i0@x1 medium_250_i0@x20 --workers 12 >> results\experiment_b1.log 2>&1
echo suite_a exit %errorlevel% >> results\experiment_b1.log
.venv\Scripts\python.exe -u scripts\experiment.py --name suite_b --policies final imoead ip_moea fixed_fav heuristics trained_stable fresh nsga2_mid nsga2_int nsga3_mid imoead_awn imea_ied --train-seeds 0 1 2 --reference final --rank-metric IGD --scenario jin --energy-scope device --external-io device --makespan sum_apps --generations 1000 --seeds 10 --test-set cybershake_100@x1 cybershake_100@x20 cybershake_100@x100 cybershake_400@x1 cybershake_400@x20 cybershake_400@x100 cybershake_1000@x1 cybershake_1000@x20 cybershake_1000@x100 epigenomics_100@x1 epigenomics_100@x20 epigenomics_100@x100 epigenomics_400@x1 epigenomics_400@x20 epigenomics_400@x100 epigenomics_1000@x1 epigenomics_1000@x20 epigenomics_1000@x100 inspiral_100@x1 inspiral_100@x20 inspiral_100@x100 inspiral_400@x1 inspiral_400@x20 inspiral_400@x100 inspiral_1000@x1 inspiral_1000@x20 inspiral_1000@x100 montage_100@x1 montage_100@x20 montage_100@x100 montage_400@x1 montage_400@x20 montage_400@x100 montage_1000@x1 montage_1000@x20 montage_1000@x100 sipht_100@x1 sipht_100@x20 sipht_100@x100 sipht_400@x1 sipht_400@x20 sipht_400@x100 sipht_1000@x1 sipht_1000@x20 sipht_1000@x100 --workers 12 >> results\experiment_b1.log 2>&1
echo exit %errorlevel% >> results\experiment_b1.log
